@{ViewData["Title"]="FAQ";}
<section class="inner-hero"><div><span class="eyebrow">FAQ / QUESTIONS</span><h1>Answers before you <em>start.</em></h1><p>Common questions about websites, software, apps, technology, SEO and marketing.</p></div><div class="inner-visual"><img src="~/images/svc-ai.svg" alt=""/></div></section>
<section class="section"><div class="faq-list">
@foreach(var q in new[]{("How much does a website cost?","Cost depends on pages, design complexity, integrations, CMS, e-commerce features and content. Send the requirement for a tailored estimate."),("How long does development take?","A simple website can be planned quickly, while custom applications depend on scope and integrations. We define milestones before development."),("Do you build custom .NET websites?","Yes. We can build ASP.NET Core MVC websites, Web APIs, dashboards and business applications."),("Do you work with Python and Django?","Yes. Python can be used for backend systems, data workflows, automation and AI-oriented applications, including Django."),("Do you develop Java applications?","Yes. Java and Spring-based backend systems can be used where they fit the project architecture."),("Can you build mobile apps?","Yes. We can work with Flutter, Android, Kotlin, Java, Swift and React Native depending on the requirements."),("Do you develop APIs?","Yes. REST APIs, authentication, third-party integrations, webhooks and business APIs are part of our software services."),("Do you provide SEO?","Yes. Technical SEO, on-page optimisation, analytics, structured data and ongoing search improvement can be included."),("Do you manage Google and Meta Ads?","Yes. Campaign setup, tracking, audiences, creative direction and optimisation can be provided."),("Can you redesign my existing website?","Yes. We can audit the existing website, preserve important content and upgrade design, performance and structure."),("Can you integrate payment gateways?","Payment gateway integration can be planned around the provider, country, security requirements and existing application architecture."),("Do you provide maintenance?","Yes. Maintenance can cover bug fixes, security updates, content changes, performance improvements and new features."),("Which programming languages do you use?","C#, C/C++, Java, Python, JavaScript, TypeScript, PHP and SQL are among the technologies we can use depending on the project."),("Do you provide hosting and deployment?","We can assist with IIS, Linux, Azure, AWS, Docker and deployment configuration. Hosting ownership and credentials remain with the client unless otherwise agreed.")}) {<details class="faq-item"><summary>@q.Item1 <span>+</span></summary><p>@q.Item2</p></details>}
</div></section>
@await Html.PartialAsync("_Commitments")
@await Html.PartialAsync("_Cta")
