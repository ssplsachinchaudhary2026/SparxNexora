@model ContactRequest
@{ViewData["Title"]="Contact Us";}
<section class="inner-hero"><div><span class="eyebrow">CONTACT / START A PROJECT</span><h1>Tell us what you want to <em>build.</em></h1><p>Share your requirements, preferred timeline and technology needs. For a faster conversation, use WhatsApp.</p></div><div class="inner-visual"><img src="~/images/trust-shield.svg" alt=""/></div></section>
<section class="section contact-layout"><div class="contact-info reveal"><div class="contact-card"><span class="eyebrow">DIRECT CONTACT</span><h2>+91 93688 50493</h2><p>WhatsApp us with a short description of your project and we'll continue the conversation there.</p><a class="btn primary" href="https://wa.me/919368850493?text=Hi%20Sparx%20Nexora%2C%20I%20want%20to%20discuss%20a%20project." target="_blank">Open WhatsApp ↗</a></div><div class="contact-card"><span class="eyebrow">EMAIL</span><h3>Business Enquiry</h3><p>Configure the business email in <code>appsettings.json</code> and the contact form will send enquiries there.</p></div><div class="contact-card"><span class="eyebrow">GOOD TO INCLUDE</span><p>Website pages · Features · Reference websites · App platforms · Integrations · Budget · Timeline · SEO/Ads goals</p></div></div><form asp-action="Contact" method="post" class="contact-form reveal">@Html.AntiForgeryToken()<div class="field"><label>Name *</label><input asp-for="Name" placeholder="Your name"/></div><div class="field"><label>Email *</label><input asp-for="Email" placeholder="you@company.com"/></div><div class="field"><label>Phone / WhatsApp</label><input asp-for="Phone" placeholder="+91..."/></div><div class="field"><label>Company</label><input asp-for="Company" placeholder="Company name"/></div><div class="field"><label>Service</label><select asp-for="Service"><option value="">Select service</option><option>Website Development</option><option>Web Application</option><option>Mobile App</option><option>Custom Software</option><option>AI / Data</option><option>API Development</option><option>SEO</option><option>Google Ads</option><option>Meta Ads</option><option>Complete Digital Solution</option></select></div><div class="field"><label>Project Type</label><select asp-for="ProjectType"><option value="">Select type</option><option>New Project</option><option>Redesign</option><option>Maintenance</option><option>Migration</option><option>MVP / Startup</option></select></div><div class="field"><label>Budget</label><select asp-for="Budget"><option value="">Choose range</option><option>₹10,000 – ₹25,000</option><option>₹25,000 – ₹50,000</option><option>₹50,000 – ₹1,00,000</option><option>₹1,00,000+</option></select></div><div class="field"><label>Timeline</label><select asp-for="Timeline"><option value="">Choose timeline</option><option>Urgent</option><option>1–2 Weeks</option><option>1 Month</option><option>2–3 Months</option><option>Flexible</option></select></div><div class="field full"><label>Requirement *</label><textarea asp-for="Message" rows="8" placeholder="Tell us about your website/app/software, pages, features, integrations and goals..."></textarea></div><div class="form-actions full"><button class="btn primary" type="submit">Send Requirement ↗</button><a class="btn whatsapp-btn" href="https://wa.me/919368850493?text=Hi%20Sparx%20Nexora%2C%20I%20want%20to%20discuss%20a%20project." target="_blank">Chat on WhatsApp</a></div></form></section>
<section class="section"><div class="section-head reveal"><span class="eyebrow">WHAT HAPPENS NEXT</span><h2>Simple, <em>transparent</em> next steps.</h2></div><div class="steps3"><div class="reveal"><h3>We review</h3><p>Our team reads your requirement and may ask a few clarifying questions.</p></div><div class="reveal"><h3>We propose</h3><p>You receive a scope, suggested technology, timeline and honest estimate.</p></div><div class="reveal"><h3>We build</h3><p>Once approved, work begins in small milestones with regular updates.</p></div></div></section>
@if(TempData["Success"] is string msg){<div class="toast">@msg</div>}
@await Html.PartialAsync("_Commitments")
